# Copy to .env and fill in what you use. Everything is optional except the Anthropic key for chat.

# Where your brain lives (SQLite + nothing else). Default: ~/.ignyte
# IGNYTE_DATA_DIR=~/.ignyte
# Region used to parse phone numbers without a country code.
IGNYTE_DEFAULT_COUNTRY=US

# Claude (chat + tool use). `ant auth login` also works instead of a key.
ANTHROPIC_API_KEY=
# IGNYTE_MODEL=claude-opus-5
# IGNYTE_EFFORT=high

# Google: a Desktop-app OAuth client from your own Google Cloud project (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GMAIL_LOOKBACK_DAYS=1095
# GMAIL_ALL_MAIL=1   # also sync team-alias / group mail not addressed to you (much slower)
# CALENDAR_LOOKBACK_DAYS=1095
# CALENDAR_LOOKAHEAD_DAYS=60

# Enrichment: pdl (People Data Labs, default) or apollo.
ENRICHMENT_PROVIDER=pdl
PDL_API_KEY=
APOLLO_API_KEY=
# ENRICHMENT_REFRESH_DAYS=180

# Optional semantic search (Voyage AI embeddings). Without it, search is keyword + filters.
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite

# Optional: resolve X archive account ids to handles/names (X API, billed per request).
X_BEARER_TOKEN=

# PORT=4321
