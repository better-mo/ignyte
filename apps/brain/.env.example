# Copy to .env. Only the first two sections are needed.

# Claude (chat). Required.
ANTHROPIC_API_KEY=

# Google: a Desktop-app OAuth client from your own Google Cloud project (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional (see docs/advanced.md) ----

# Where your data lives. Default: ~/.ignyte
# IGNYTE_DATA_DIR=~/.ignyte
# Region for phone numbers without a country code.
# IGNYTE_DEFAULT_COUNTRY=US
# IGNYTE_MODEL=claude-opus-5
# IGNYTE_EFFORT=high

# How far back the first sync reads (days).
# GMAIL_LOOKBACK_DAYS=1095
# CALENDAR_LOOKBACK_DAYS=1095
# CALENDAR_LOOKAHEAD_DAYS=60
# GMAIL_ALL_MAIL=1   # also sync team-alias / group mail not addressed to you (much slower)

# Enrichment: pdl (People Data Labs) or apollo.
# ENRICHMENT_PROVIDER=pdl
# PDL_API_KEY=
# APOLLO_API_KEY=
# ENRICHMENT_PER_MINUTE=10
# ENRICHMENT_REFRESH_DAYS=180

# Semantic search (Voyage embeddings). Without it, search is keywords + filters.
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite

# Resolve X archive account ids to handles (X API, billed per request).
# X_BEARER_TOKEN=

# PORT=4321
